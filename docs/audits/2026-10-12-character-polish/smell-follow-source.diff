+  await page.clock.runFor(360 + 120)
+  const first = await resident.evaluate(read), samples = []
+  let maxFootDrift = 0
+  for (let elapsed = 120; elapsed <= 1440; elapsed += 16) {
+    const sample = await resident.evaluate(read)
+    if (!samples.length || sample.time !== samples.at(-1).time) samples.push(sample)
+    assert.equal(sample.frames, 1)
+    assert.equal(sample.pose, 'idle', 'the fixture keeps the neutral appendage baseline')
+    assert.equal(sample.position, first.position)
+    for (let i = 0; i < 2; i++) maxFootDrift = Math.max(maxFootDrift, Math.hypot(sample.feet[i].x - first.feet[i].x, sample.feet[i].y - first.feet[i].y))
+    if (elapsed === 600 && process.env.CHORE_SMELL_FOLLOW_CAPTURE_DIR) {
+      await mkdir(process.env.CHORE_SMELL_FOLLOW_CAPTURE_DIR, { recursive: true })
+      await page.screenshot({ path: join(process.env.CHORE_SMELL_FOLLOW_CAPTURE_DIR, `smell-follow-room-${species}.png`), fullPage: false })
