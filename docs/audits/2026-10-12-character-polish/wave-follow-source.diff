+    await png(`wave-follow-${label}-${variant}-sizes.png`, 1320, 1380, cells)
+  }
+  const colours = { mochi: '#ca6080', bun: '#397dbb', sprout: '#568747' }, curveSamples = []
+  const x0 = 54, y0 = 50, width = 430, height = 200, duration = ACTION_MS.wave
+  const curves = speciesList.map(species => {
