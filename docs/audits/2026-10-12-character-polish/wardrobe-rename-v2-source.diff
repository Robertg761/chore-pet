+  await page.getByRole('button', { name: 'Resume movement preview of Mochi', exact: true }).click(); await page.clock.runFor(1640)
+  assert.equal(await page.getByRole('button', { name: 'Rest', exact: true }).isEnabled(), true)
+  assert.equal(await page.evaluate(() => window.__renameFrames.size), 0)
+  const expected = structuredClone(saved); Object.values(expected.pets)[0].outfits[0].name = 'Held look'
+  assert.deepEqual((await snapshot(page)).tables, expected)
+  await capture(page, 'wardrobe-rename-held-preview', { method: 'Native Escape cancellation, explicit rename,60000ms held mirrored rest and remaining-duration cleanup; no clothing/progress/table changes except saved name.' })
+})
+
+test('new-look saving remains separate and returns visible focus to its own saved card', async t => {
+  const page = await fixture(t, 1280, 800, 100)
+  await page.getByRole('button', { name: 'Remove Party clothes', exact: true }).click()
+  await page.getByRole('group', { name: 'Remove Party clothes?', exact: true }).getByRole('button', { name: 'Remove', exact: true }).click()
+  await page.getByRole('button', { name: 'Red beanie', exact: true }).click()
+  const before = (await snapshot(page)).tables, petBefore = Object.values(before.pets)[0]
+  assert.equal(petBefore.outfits.length, 2); assert.equal(petBefore.equipped.head, undefined)
+  const save = page.getByRole('button', { name: 'Save this outfit', exact: true })
+  await save.click()
+  const field = page.getByRole('textbox', { name: 'Outfit name', exact: true })
+  await field.fill('Discard'); await page.keyboard.press('Escape')
+  assert.equal(await save.evaluate(node => node === document.activeElement), true)
+  assert.deepEqual((await snapshot(page)).tables, before)
+  await save.click(); await field.fill('New look'); await page.keyboard.press('Enter')
+  const rename = page.getByRole('button', { name: 'Rename New look', exact: true })
+  assert.equal(await rename.evaluate(node => node === document.activeElement), true)
+  const view = await layout(page); assertLayout(view); assert.equal(view.frames, 0)
+  const after = (await snapshot(page)).tables, petAfter = Object.values(after.pets)[0], added = petAfter.outfits[2]
+  assert.ok(added.id && !petBefore.outfits.some(o => o.id === added.id)); assert.equal(added.name, 'New look')
+  assert.deepEqual(added.equipped, petBefore.equipped)
+  const expected = structuredClone(before); Object.values(expected.pets)[0].outfits.push(added)
+  assert.deepEqual(after, expected)
+  await capture(page, 'wardrobe-rename-new-look', { layout: view, method: 'Explicit removal frees a slot, item change selects an unsaved look, Escape cancels new-name editing, Save outfit adds a distinct ID and returns visible focus to its own Rename control. Existing equipped data is preserved during naming.' })
+})
