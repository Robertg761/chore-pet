+// Bounded static production art and numeric hand curves; no live motion clock.
+import { createServer } from 'vite'
+import React from 'react'
+import { renderToStaticMarkup } from 'react-dom/server'
+import { Resvg } from '@resvg/resvg-js'
+import { readFile, writeFile } from 'node:fs/promises'
+import { createHash } from 'node:crypto'
+const label = process.argv[2], out = 'docs/audits/2026-10-12-character-polish'
+if (!['before', 'after'].includes(label)) throw new Error('Expected before or after')
+const baseline = await readFile(`${out}/dust-hand-baseline.ts.txt`, 'utf8')
+const server = await createServer({ plugins: [{ name: 'dust-hand-baseline', enforce: 'pre', transform(code, id) {
+  if (label === 'before' && id.split('?')[0] === `${process.cwd()}/src/character/motion.ts`) return { code: baseline, map: null }
+} }], server: { middlewareMode: true, hmr: false, ws: false }, appType: 'custom' })
+try {
+  const { AnimatedCharacterArt } = await server.ssrLoadModule('/src/character/AnimatedCharacter.tsx')
+  const { sampleMotion, ACTION_MS } = await server.ssrLoadModule('/src/character/motion.ts')
+  const { SPECIES_COLOUR, PALETTE } = await server.ssrLoadModule('/src/art/palette.ts')
+  const { PET_STROKE_SCALE } = await server.ssrLoadModule('/src/room/shell/geometry.ts')
+  const h = React.createElement, speciesList = ['mochi', 'bun', 'sprout'], samples = [], files = []
+  const equipped = { head: 'beanie-red', face: 'glasses', neck: 'scarf', outfit: 'overalls', back: 'backpack' }
+  const at = (species, elapsedMs, mood = 'happy') => sampleMotion({ species, action: 'dust', mood, elapsedMs, blinkMs: elapsedMs, distance: 0, durationMs: ACTION_MS.dust, reducedMotion: false })
+  async function png(name, width, height, children) {
+    const markup = renderToStaticMarkup(h('svg', { xmlns: 'http://www.w3.org/2000/svg', width, height }, h('rect', { width: '100%', height: '100%', fill: PALETTE.cream }), children))
+    await writeFile(`${out}/${name}`, new Resvg(markup).render().asPng()); files.push(name)
+  }
+  for (const variant of ['light', 'dark']) {
+    const cells = [], mood = variant === 'light' ? 'happy' : 'scruffy'
+    for (const species of speciesList) for (const facing of [1, -1]) for (const phase of [.24, .42, .6, .76]) {
+      const frame = at(species, ACTION_MS.dust * phase, mood)
+      const draw = size => h('g', { transform: facing === -1 ? 'translate(200 0) scale(-1 1)' : undefined }, h(AnimatedCharacterArt,
+        { species, mood, frame, equipped, bodyColour: variant === 'dark' ? PALETTE.ink : SPECIES_COLOUR[species], strokeScale: size === 25 ? PET_STROKE_SCALE : 1 }))
+      const views = [200, 60, 25].map((size, i) => h('g', { key: size, transform: `translate(${[0, 205, 280][i]} ${100 - size / 2}) scale(${size / 200})` }, draw(size)))
+      cells.push(h('g', { key: cells.length, transform: `translate(${cells.length % 4 * 330} ${Math.floor(cells.length / 4) * 230})` }, views,
+        h('text', { x: 8, y: 220, fontSize: 11, fill: PALETTE.ink }, `${species} dust f${facing} ${phase * 100}%;200/60/25px`)))
+      samples.push({ variant, mood, species, facing, phase, frame })
+    }
+    await png(`dust-hand-${label}-${variant}-sizes.png`, 1320, 1380, cells)
+  }
+  const colours = { mochi: '#ca6080', bun: '#397dbb', sprout: '#568747' }, curveSamples = []
+  const x0 = 54, y0 = 50, width = 430, height = 200, duration = ACTION_MS.dust
+  const curves = speciesList.map(species => {
+    const points = Array.from({ length: 701 }, (_, n) => { const ms = duration * n / 700; return { ms, angle: at(species, ms).rightArm } })
+    curveSamples.push({ species, points })
+    return h('path', { key: species, d: points.map((p, n) => `${n ? 'L' : 'M'}${(x0 + p.ms / duration * width).toFixed(3)} ${(y0 - p.angle / 32 * height).toFixed(3)}`).join(' '), fill: 'none', stroke: colours[species], strokeWidth: 1.8 })
+  })
+  await png(`dust-hand-${label}-curves.png`, 520, 290, h('g', null,
+    h('text', { x: x0, y: 20, fontSize: 14, fill: PALETTE.ink }, `dust:right hand angle over ${duration}ms`),
+    speciesList.map((species, n) => h('text', { key: species, x: x0 + n * 130, y: 39, fontSize: 12, fill: colours[species] }, species)),
+    [0, -8, -16, -24, -32].map(angle => h('g', { key: angle }, h('path', { d: `M${x0} ${y0 - angle / 32 * height} h${width}`, stroke: '#d8d0c4', fill: 'none' }),
+      h('text', { x: 12, y: y0 - angle / 32 * height + 4, fontSize: 11, fill: PALETTE.ink }, `${angle}°`))), curves,
+    [0, duration / 2, duration].map(ms => h('text', { key: ms, x: x0 + ms / duration * width, y: 275, textAnchor: 'middle', fontSize: 11, fill: PALETTE.ink }, `${ms}ms`))))
+  const hash = bytes => createHash('sha256').update(bytes).digest('hex')
+  const sources = ['src/character/motion.ts', 'src/character/AnimatedCharacter.tsx', 'src/character/species/animatedBody.tsx', 'src/character/parts.tsx', 'src/character/Character.tsx', 'src/art/palette.ts', 'src/room/shell/geometry.ts', `${out}/capture-dust-hand.mjs`]
+  await writeFile(`${out}/dust-hand-${label}.json`, JSON.stringify({ method: '48dressed species/mirror/phase/light-happy-or-dark-scruffy samples,144views at200/60/25px,and three right-hand angle/time curves. Static/numeric only;no human temporal playback. Exacte95d617 sampler baseline.', samples, curveSamples,
+    sourceSha256: Object.fromEntries(await Promise.all(sources.map(async path => [path, hash(label === 'before' && path === 'src/character/motion.ts' ? baseline : await readFile(path))]))),
+    captureSha256: Object.fromEntries(await Promise.all(files.map(async file => [file, hash(await readFile(`${out}/${file}`))]))) }, null, 2) + '\n')
