+})
+
+for (const [width, height] of [[320, 640], [390, 664], [844, 390]]) test(`plant greeting fits ${width}x${height} with attached leaves`, async t => {
+  const page = await fixture(t, { width, height }), saved = (await snapshot(page)).tables
