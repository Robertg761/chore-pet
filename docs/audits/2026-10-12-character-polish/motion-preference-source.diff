+  media = Object.assign(new EventTarget(), { matches: false }) as MediaQueryList
+  vi.stubGlobal('matchMedia', () => media)
+  vi.stubGlobal('requestAnimationFrame', vi.fn())
+  vi.stubGlobal('cancelAnimationFrame', vi.fn())
